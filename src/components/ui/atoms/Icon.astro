---
interface Props {
  name: string;
  weight?: 'regular' | 'bold' | 'fill' | 'thin' | 'light' | 'duotone';
  size?: string | number;
  class?: string;
}

const { 
  name, 
  weight = 'regular', 
  size, 
  class: className 
} = Astro.props;

// Why: data from client projects sometimes already contains the "ph-" prefix.
// Normalization prevents the "ph-ph-name" class, which does not exist in CSS.
const iconName = name.replace(/^ph-/, '');

// Determine if size is numeric or string
const fontSize = typeof size === 'number' ? `${size}px` : size;

// Why: regular is the base "ph" class in Phosphor Icons CSS.
// Other weights (bold, fill, thin etc.) have suffix "ph-bold", "ph-fill" etc.
// Without this fix CSS selectors (.ph.ph-check:before) do not match and icons do not render.
const weightClass = weight === 'regular' ? 'ph' : `ph-${weight}`;
---

<i
  class:list={[
    `${weightClass} ph-${iconName}`,
    className
  ]}
  style={fontSize ? `font-size: ${fontSize}` : undefined}
></i>
