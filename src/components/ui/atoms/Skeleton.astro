---
interface Props {
    width?: string;
    height?: string;
    variant?: 'text' | 'rect' | 'circle';
    className?: string;
}

const { 
    width = "100%", 
    height = "1rem", 
    variant = "rect",
    className = "" 
} = Astro.props;

const variants = {
    text: "rounded-md",
    rect: "rounded-2xl",
    circle: "rounded-full"
};
---

<div 
    class={`bg-brand-dark/5 ${variants[variant]} ${className}`}
    style={`width: ${width}; height: ${height};`}
>
</div>
