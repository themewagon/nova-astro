---
// Why: Heading ensures consistent header hierarchy across the project. Seven variants define a precise typographic system for each section.
type Props = Record<string, any> & {
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	variant?: 'hero' | 'section-heading-xl' | 'section-heading-lg' | 'feature-heading-md' | 'section-title' | 'section-subtitle' | 'feature-title';
	motion?: 'fade';
	class?: string;
	tag?: string;
};

const {
	level = 2,
	variant,
	motion,
	tag,
	class: className = '',
	...rest
} = Astro.props as Props;
// Why: Dynamic Tag allows using any HTML element (h1-h6 or e.g. div) while preserving semantics and accessibility.
const Tag = tag || `h${level}`;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
	'hero': 'ui-type-heading-hero',
	'section-heading-xl': 'ui-type-heading-section-xl',
	'section-heading-lg': 'ui-type-heading-section-lg',
	'feature-heading-md': 'ui-type-heading-feature-md',
	'section-title': 'ui-type-section-title',
	'section-subtitle': 'ui-type-section-subtitle',
	'feature-title': 'ui-type-feature-title',
};

const appliedVariantClass = variant ? variantClasses[variant] : '';
const motionAttrs = motion === 'fade' ? { 'data-motion': 'fade' } : {};
---

<Tag 
	class:list={["font-heading font-bold", appliedVariantClass, className]}
	{...rest}
	{...motionAttrs}
>
	<slot />
</Tag>
