---
interface Props {
  type?: 'text' | 'search' | 'email' | 'tel' | 'number' | 'url' | 'password' | 'date';
  name?: string;
  id?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  class?: string;
  [key: string]: any;
}

const { 
  type = 'text', 
  name, 
  id, 
  placeholder, 
  value, 
  required = false, 
  class: className,
  ...rest 
} = Astro.props;
---

<input
  type={type}
  name={name}
  id={id}
  placeholder={placeholder}
  value={value}
  required={required}
  class:list={["ui-form-input", className]}
  {...rest}
/>
