---
type Props = Record<string, any> & {
	variant?: 'body' | 'lead' | 'accent-label' | 'feature-body-sm' | 'disclaimer';
	motion?: 'fade';
	class?: string;
	tag?: string;
};

const {
	variant,
	motion,
	class: className = '',
	tag: Tag = 'p',
	...rest
} = Astro.props as Props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
	'body': 'ui-type-body',
	'lead': 'ui-type-lead',

	'accent-label': 'ui-type-accent-label',
	'feature-body-sm': 'ui-type-text-feature-sm',
	'disclaimer': 'ui-type-disclaimer',
};

const appliedVariantClass = variant ? variantClasses[variant] : '';
const motionAttrs = motion === 'fade' ? { 'data-motion': 'fade' } : {};
---

<Tag 
	class:list={["leading-relaxed", appliedVariantClass, className]} 
	{...rest}
	{...motionAttrs}
>
	<slot />
</Tag>
