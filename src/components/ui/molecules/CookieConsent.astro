---
// Why: CookieConsent is a legal requirement (GDPR). The banner must appear before any analytical/marketing cookies are stored. Two buttons (accept and necessary) give the user a clear choice.
import cookieData from "@data/global/cookie-consent.json";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

interface Props {
  title?: string;
  description?: string;
  acceptLabel?: string;
  essentialLabel?: string;
}

const { title: titleProp, description: descriptionProp, acceptLabel: acceptLabelProp, essentialLabel: essentialLabelProp } = Astro.props;

// Dlaczego: teksty banera czytamy z cookie-consent.json (edytowalne w CMS).
// Props take precedence and hardcoded PL is just the ultimate fallback.
const title = titleProp || cookieData.title || "Prywatność i Cookies";
const description = descriptionProp || cookieData.description || "Używamy plików cookie, aby poprawić wygodę przeglądania. Korzystając ze strony, zgadzasz się na naszą <a href=\"/cookies/\" class=\"font-semibold text-brand-primary underline decoration-brand-primary/30 underline-offset-4 hover:decoration-brand-primary transition-all\">politykę prywatności</a>.";
const acceptLabel = acceptLabelProp || cookieData.acceptLabel || "Akceptuję";
const essentialLabel = essentialLabelProp || cookieData.essentialLabel || "Niezbędne";
const acceptHover = cookieData.hover || "Rozumiem!";
const essentialHover = cookieData.essentialHover || cookieData.essentialLabel || "Tylko te";
---

<div
  id="cookie-consent"
  aria-hidden="true"
  class="fixed bottom-6 left-6 right-6 z-[2000] hidden md:left-6 md:right-auto md:max-w-[400px] w-auto min-w-0"
>
    <div class="relative overflow-hidden rounded-[2rem] border border-white/40 bg-white/70 p-7 shadow-[0_20px_50px_rgba(0,0,0,0.1)] backdrop-blur-2xl">
      <div class="flex min-w-0 flex-col gap-6">
        <div class="flex min-w-0 items-center gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary">
            <i class="ph ph-cookie text-2xl"></i>
          </div>
          <Heading level={3} variant="feature-title" class="min-w-0 text-lg text-brand-dark">
            {title}
          </Heading>
        </div>
        
        <Text class="min-w-0 text-[0.9375rem] text-brand-dark/70" set:html={description} />

        <div class="flex min-w-0 gap-3">
          <button
            id="accept-cookies"
            class="ui-button ui-button-primary ui-type-cta-label font-semibold min-h-[44px] min-w-0 flex-1 !rounded-xl !px-5 !py-2.5 !text-sm"
          >
            <span class="ui-button-text-wrap">
              <span class="ui-button-text-default">{acceptLabel}</span>
              <span class="ui-button-text-hover">{acceptHover}</span>
            </span>
          </button>
          <button
            id="decline-cookies"
            class="ui-button ui-button-outline ui-type-cta-label font-semibold min-h-[44px] min-w-0 flex-1 !rounded-xl !px-5 !py-2.5 !text-sm"
          >
            <span class="ui-button-text-wrap">
              <span class="ui-button-text-default">{essentialLabel}</span>
              <span class="ui-button-text-hover">{essentialHover}</span>
            </span>
          </button>
        </div>
      </div>
    </div>
</div>

<!-- The banner is not needed for the first render, so its support loads after HTML parsing.-->
<script is:inline src="/js/cookie-consent.js" defer></script>
