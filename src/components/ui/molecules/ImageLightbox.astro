---
import lightboxData from "@data/global/lightbox.json";

export interface Props {
  closeLabel?: string;
  lightboxAlt?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const { closeLabel, lightboxAlt, prevLabel, nextLabel } = Astro.props;

// Dlaczego: etykiety lightboxa czytamy z lightbox.json (edytowalne w CMS),
// props take precedence and JSON is SSOT (no fallback in the code).
const close = closeLabel || lightboxData.closeLabel || "";
const alt = lightboxAlt || lightboxData.alt || "";
const previous = prevLabel || lightboxData.prevLabel || "";
const next = nextLabel || lightboxData.nextLabel || "";
const empty = lightboxData.emptyLabel || "";
---
<!-- Why: ImageLightbox is a global full-screen image viewing modal. Uses native <dialog> instead of div, which gives built-in support for closure (Escape, click outside) and accessibility (aria-modal).-->
{/* Global Lightbox Modal */}
<dialog id="ui-lightbox" class="bg-transparent p-0 m-0 w-full h-full max-w-none max-h-none backdrop:bg-black/90 fixed inset-0 z-[100] open:flex justify-center items-center">
    <div class="relative flex h-full w-full flex-col items-center justify-center p-2 sm:p-4 md:p-8">
        
        <div class="relative flex max-h-[calc(100dvh-9rem)] max-w-full items-center justify-center sm:max-h-[calc(100dvh-7rem)]">
            <img id="ui-lightbox-img" src="" alt={alt} loading="lazy" class="max-w-full max-h-full object-contain drop-shadow-2xl ui-radius-xl" />

            <div id="ui-lightbox-placeholder" class="hidden min-h-56 min-w-[min(78vw,32rem)] flex flex-col items-center justify-center gap-3 rounded-xl border border-white/15 bg-white/5 px-8 py-12 text-center text-white/70" role="status" aria-live="polite">
                <svg class="h-10 w-10 text-white/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <circle cx="8.5" cy="9" r="1.5"></circle>
                    <path d="m4 17 4.5-4.5 3 3 2-2L20 20"></path>
                </svg>
                <span id="ui-lightbox-placeholder-label" class="text-sm font-medium tracking-wide">{empty}</span>
            </div>

            <button id="ui-lightbox-close" class="absolute -top-14 right-0 flex h-11 w-11 items-center justify-center text-white sm:top-0" aria-label={close}>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/70 shadow-lg transition-colors hover:bg-black/90 sm:h-9 sm:w-9">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sm:h-4 sm:w-4">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </span>
            </button>

            <button id="ui-lightbox-prev" class="absolute bottom-[-4rem] left-0 hidden h-11 w-11 items-center justify-center text-white disabled:pointer-events-none disabled:opacity-30 sm:bottom-auto sm:left-1 sm:top-1/2 sm:-translate-y-1/2 md:left-5 md:h-12 md:w-12" aria-label={previous} type="button">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/70 transition-colors hover:bg-black/90 sm:h-9 sm:w-9 md:h-10 md:w-10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sm:h-5 sm:w-5">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                </span>
            </button>

            <button id="ui-lightbox-next" class="absolute bottom-[-4rem] right-0 hidden h-11 w-11 items-center justify-center text-white disabled:pointer-events-none disabled:opacity-30 sm:bottom-auto sm:right-1 sm:top-1/2 sm:-translate-y-1/2 md:right-5 md:h-12 md:w-12" aria-label={next} type="button">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/70 transition-colors hover:bg-black/90 sm:h-9 sm:w-9 md:h-10 md:w-10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sm:h-5 sm:w-5">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </span>
            </button>
            
            {/* Loading spinner (optional) */}
            <div id="ui-lightbox-loader" class="absolute inset-0 flex justify-center items-center -z-10 text-white/50">
                <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <div id="ui-lightbox-caption" class="absolute inset-x-0 bottom-0 rounded-b-xl bg-gradient-to-t from-black/70 via-black/30 to-transparent px-4 pb-4 pt-10 text-center text-base font-medium tracking-wide text-white drop-shadow-md sm:text-lg"></div>
            </div>
        </div>
</dialog>

<script is:inline src="/js/lightbox.js?v=2" defer></script>
