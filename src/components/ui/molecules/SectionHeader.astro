---
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

type HeadingVariant = 'hero' | 'section-heading-xl' | 'section-heading-lg' | 'feature-heading-md' | 'section-title' | 'section-subtitle' | 'feature-title';

interface Props {
	tagline?: string;
	title?: string;
	titleAccent?: string;
	description?: string;
	align?: 'left' | 'center' | 'right';
	variant?: 'hero' | 'section';
	titleVariant?: HeadingVariant;
	titleTag?: string;
	hasMargin?: boolean;
	class?: string;
	theme?: 'light' | 'dark';
}

const { 
	tagline, 
	title, 
	titleAccent, 
	description, 
	align = 'left', 
	variant = 'section',
	titleVariant,
	titleTag,
	hasMargin = true,
	class: className = '',
	theme = 'light'
} = Astro.props;

const alignmentClasses = {
	left: 'text-left items-start',
	center: 'text-center items-center',
	right: 'text-right items-end'
};
---

<div class:list={[
	"flex flex-col gap-6", 
	alignmentClasses[align], 
	(variant === 'section' && hasMargin) ? "mb-12 md:mb-16" : "",
	align === 'center' ? "mx-auto max-w-2xl" : "max-w-3xl",
	className
]}>
	{tagline && (
		<Text variant="accent-label">
			<slot name="tagline">{tagline}</slot>
		</Text>
	)}
	
	<Heading 
		tag={titleTag || (variant === 'hero' ? 'h1' : 'h2')} 
		variant={titleVariant || (variant === 'hero' ? 'hero' : 'section-title')}
		class:list={[theme === 'dark' ? 'text-white' : 'text-brand-dark']}
	>
		<slot name="title">
			{title}{titleAccent && <>{' '}<span class="text-brand-primary" set:html={titleAccent}></span></>}
		</slot>
	</Heading>

	{(description || Astro.slots.has('description')) && (
		<Text 
			variant="lead" 
			class:list={[
				"max-w-2xl font-normal", 
				theme === 'dark' ? 'ui-text-on-dark-subtle' : 'ui-text-on-light-subtle',
				align === 'center' && 'mx-auto'
			]}
		>
			<slot name="description">{description}</slot>
		</Text>
	)}
</div>
