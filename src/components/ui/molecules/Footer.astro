---
import Container from "@components/ui/layout/Container.astro";
import Text from "@components/ui/atoms/Text.astro";
import Logo from "@components/ui/atoms/Logo.astro";
import footerData from "@data/navigation/footer.json";
import companyData from "@data/global/company.json";

interface Props {
	id?: string;
	class?: string;
}

const { id, class: className = "" } = Astro.props;

type LinkItem = { label: string; href: string };
type ColumnItem = { title: string; links: LinkItem[] };
const footer = footerData as {
	about?: string;
	columns?: ColumnItem[];
	legal?: LinkItem[];
	contactTitle?: string;
	copyrightText?: string;
	attribution?: { label?: string; href?: string; prefix?: string; linkLabel?: string };
};
const company = companyData as {
	name?: string;
	fullName?: string;
	email?: string;
	phone?: string;
	address?: string;
	zipCode?: string;
	city?: string;
};
const fullName = company.fullName || company.name || "Starter Kit";
---

<footer id={id} transition:animate="none" class:list={["bg-slate-100 rounded-t-[2rem] md:rounded-t-[3rem]", className]}>
	<Container>
		<div class="grid grid-cols-1 gap-12 py-16 text-center md:grid-cols-2 md:gap-8 md:text-left lg:grid-cols-4 lg:gap-12">
			<div class="flex flex-col items-center gap-4 md:items-start lg:col-span-1">
				<Logo variant="dark" />
				<Text variant="body" class="text-brand-dark/60 max-w-xs">
					{footer.about}
				</Text>
			</div>

			{footer.columns?.map((col) => (
				<div class="flex flex-col items-center gap-4 md:items-start">
					<Text variant="accent-label" class="text-brand-dark/50">{col.title}</Text>
					<ul class="flex flex-col gap-3">
						{col.links.map((link: LinkItem) => (
							<li>
								<a
									href={link.href}
									class="relative inline-block text-sm text-brand-dark/70 underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}

			<div class="flex flex-col items-center gap-4 md:items-start">
				<Text variant="accent-label" class="text-brand-dark/50">{footer.contactTitle}</Text>
				<ul class="flex flex-col gap-3 text-sm text-brand-dark/70">
				{company.address ? (
					<li class="not-italic leading-relaxed">
						<a
							href={`https://www.google.com/maps?q=${encodeURIComponent(company.address)}`}
							target="_blank"
							rel="noopener"
							class="relative inline-block underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full"
						>
							{company.address}
						</a>
					</li>
				) : null}
					{company.phone ? (
						<li>
							<a href={`tel:${company.phone.replace(/\s/g, "")}`} class="relative inline-block underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full">
								{company.phone}
							</a>
						</li>
					) : null}
					{company.email ? (
						<li>
							<a href={`mailto:${company.email}`} class="relative inline-block underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full">
								{company.email}
							</a>
						</li>
					) : null}
				</ul>
			</div>
		</div>

		<div class="flex flex-col items-center justify-between gap-4 border-t border-brand-dark/5 py-6 md:flex-row">
			<Text variant="disclaimer" class="text-brand-dark/50">
				&copy; {new Date().getFullYear()} {fullName}. {footer.copyrightText}
			</Text>
			<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
				{footer.legal?.map((link: LinkItem) => (
					<a
						href={link.href}
						class="relative inline-block text-xs text-brand-dark/50 underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full"
					>
						{link.label}
					</a>
				))}
				<a
					href={footer.attribution?.href}
					target="_blank"
					rel="noopener"
					class="relative inline-block text-xs text-brand-dark/40 underline-offset-4 transition-colors duration-200 hover:text-brand-primary after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brand-primary after:transition-[width] after:duration-300 after:ease-out hover:after:w-full"
				>
					{footer.attribution?.label}
				</a>
			</div>
		</div>
	</Container>
</footer>
