---
import headerData from "@data/navigation/header.json";
import Logo from "@components/ui/atoms/Logo.astro";
import MenuToggle from "./MenuToggle.astro";
import { formatInternalLink } from "@utils/url";
---

<div class="ui-container relative flex items-center justify-between lg:justify-center">
	<a
		href={formatInternalLink("/")}
		class="relative z-[1010] flex items-center transition-colors duration-300 lg:absolute lg:left-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2"
	>
		<Logo variant="inherit" density="compact" />
	</a>

	<nav class="hidden items-center gap-6 lg:flex lg:gap-8 xl:gap-10">
		{headerData.menu.map((item) => (
			<a
				href={formatInternalLink(item.href)}
				class="ui-nav-bar-link flex items-center text-inherit opacity-75 transition-all hover:text-brand-accent hover:opacity-100"
			>
				{item.label}
			</a>
		))}
	</nav>

	<div class="relative z-[1010] flex items-center gap-3 lg:gap-4 lg:absolute lg:right-[var(--spacing-container-px)] lg:top-1/2 lg:-translate-y-1/2">
		<a href={formatInternalLink(headerData.cta.href)} class="ui-button ui-button-primary ui-nav-cta hidden sm:flex">
			<span class="ui-button-text-wrap">
				<span class="ui-button-text-default">{headerData.cta.label}</span>
				<span class="ui-button-text-hover">{headerData.cta.hoverLabel}</span>
			</span>
		</a>
		<MenuToggle />
	</div>
</div>
