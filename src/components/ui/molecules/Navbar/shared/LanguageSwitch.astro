---
import { getNovaCopy, getNovaLocalePath, type NovaLocale } from '@utils/nova-i18n';

interface Props {
  locale?: NovaLocale;
}

const { locale = 'pl' } = Astro.props as Props;
const copy = getNovaCopy(locale).navigation;
---

<div class="nova-language-switch" aria-label={copy.languageLabel}>
  <a
    href={getNovaLocalePath('pl')}
    class:list={['nova-language-switch__link', locale === 'pl' && 'is-active']}
    aria-current={locale === 'pl' ? 'page' : undefined}
  >PL</a>
  <span class="nova-language-switch__separator" aria-hidden="true">/</span>
  <a
    href={getNovaLocalePath('en')}
    class:list={['nova-language-switch__link', locale === 'en' && 'is-active']}
    aria-current={locale === 'en' ? 'page' : undefined}
  >EN</a>
</div>

<style>
  .nova-language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .nova-language-switch__link {
    border-radius: 0.25rem;
    padding: 0.35rem 0.2rem;
    color: inherit;
    opacity: 0.48;
    text-decoration: none;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .nova-language-switch__link:hover,
  .nova-language-switch__link:focus-visible,
  .nova-language-switch__link.is-active {
    color: var(--color-brand-accent);
    opacity: 1;
  }

  .nova-language-switch__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .nova-language-switch__separator {
    opacity: 0.28;
  }

  @media (prefers-reduced-motion: reduce) {
    .nova-language-switch__link {
      transition: none;
    }
  }
</style>
