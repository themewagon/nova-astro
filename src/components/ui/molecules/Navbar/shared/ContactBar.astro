---
// Why: the contact strip is separated as a shared molecule (pattern
// library) so that the NavbarContactBlock block remains readable and the bar
// could be used in another layout without copying the markup.
// Dlaczego: social link renderujemy tylko gdy jest URL, inaczej zostaje
// dead link href="#" (bad for accessibility and SEO).
import Icon from "@components/ui/atoms/Icon.astro";

interface Props {
  city?: string;
  email?: string;
  hours?: string;
  facebookUrl?: string;
}

const { city, email, hours, facebookUrl } = Astro.props;
---

<div class="ui-nav-contact-bar hidden lg:flex">
	<span class="ui-nav-contact-link">
		<Icon name="map-pin" size={16} />
		{city}
	</span>
	<span class="ui-nav-contact-divider" aria-hidden="true"></span>
	<a href={`mailto:${email}`} class="ui-nav-contact-link">
		<Icon name="envelope-simple" size={16} />
		{email}
	</a>
	<div class="ui-nav-contact-right">
		<span class="ui-nav-contact-link">
			<Icon name="clock" size={16} />
			{hours}
		</span>
		<span class="ui-nav-contact-divider" aria-hidden="true"></span>
		{facebookUrl && (
			<a
				href={facebookUrl}
				class="ui-nav-social-link"
				aria-label="Facebook"
				target="_blank"
				rel="noopener"
			>
				<Icon name="facebook-logo" size={17} />
			</a>
		)}
	</div>
</div>

<style>
	/* Why: the belt hangs on a dark background (brand-dark) with a rounded bottom,
    it looks like a "pill" stuck to the top of the page.*/
	.ui-nav-contact-bar {
		min-height: 2.75rem;
		align-items: center;
		gap: 1.25rem;
		padding-inline: clamp(1.5rem, 5vw, 4rem);
		border-radius: 0 0 1.5rem 1.5rem;
		background: var(--color-brand-dark);
		color: var(--color-brand-light);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	/* Why: bar links are inline-flex with icon next to text, hover changes
    color of the entire line including the icon ([class^="ph-"] selector).*/
	.ui-nav-contact-link {
		display: inline-flex;
		min-width: auto;
		min-height: auto;
		align-items: center;
		gap: 0.5rem;
		transition: color 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* Dlaczego: na hover link (i jego ikona) dostaje kolor akcentu.
    inverse-primary nie istnieje w :root starter-kita, uzywamy brand-accent.*/
	.ui-nav-contact-link:hover,
	.ui-nav-contact-link:hover [class^="ph-"],
	.ui-nav-contact-link:hover .ph {
		color: var(--color-brand-accent);
	}

	/* Why: pionowa linia oddzielajaca sekcje paska, przez color-mix
	   reaguje na theme (jasna przy 25% krycia). */
	.ui-nav-contact-divider {
		height: 1.25rem;
		width: 1px;
		background: color-mix(in oklab, var(--color-brand-light) 25%, transparent);
	}

	/* Why: prawa grupa (godziny + social) jest docisnieta do prawej
    krawedzi przez margin-left: auto.*/
	.ui-nav-contact-right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-left: auto;
	}

	/* Why: the social link has its own hover: a circular glow behind the icon
    (pseudo-element ::before) and zoom in slightly.*/
	.ui-nav-social-link {
		display: inline-flex;
		min-width: 0;
		min-height: 0;
		align-items: center;
		justify-content: center;
		position: relative;
		transition:
			color 300ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.ui-nav-social-link::before {
		content: "";
		position: absolute;
		inset: -6px;
		border-radius: 50%;
		background: var(--color-brand-accent);
		opacity: 0;
		transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
		z-index: -1;
	}

	.ui-nav-social-link:hover {
		color: var(--color-brand-primary);
		transform: scale(1.1);
	}

	.ui-nav-social-link:hover::before {
		opacity: 0.15;
	}

	/* Dlaczego: nav-transparent w starter-kicie zmienia wszystkie .ph na
    on-dark text (white). The bar has its dark background, so we're restoring it
    light color of icons so that they do not blend in with the background. Higher specificity
    than the global nav-transparent rule.*/
	.nav-transparent:not(.is-scrolled) .ui-nav-contact-bar .ph {
		color: var(--color-brand-light);
	}
</style>
