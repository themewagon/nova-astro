---
import { getNavDrawerSocialLinks } from "./nav-drawer-social";
import LanguageSwitch from "./LanguageSwitch.astro";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

interface Props {
	drawerMode?: "mobile" | "all";
	locale?: NovaLocale;
}

const { drawerMode = "mobile", locale = "pl" } = Astro.props;
const headerData = getNovaCopy(locale).navigation;
const rootVisibility = drawerMode === "mobile" ? "lg:hidden" : "";
const socialLinks = getNavDrawerSocialLinks();

// Why: submenu (children) wymagaja osobnej struktury wiersza:
// link nawiguje, osobny przycisk rozwijania otwiera accordion.
// Without children, the item remains a mere link.
type MenuItem = {
	label: string;
	href: string;
	children?: { label: string; href: string }[];
};

const menu = headerData.menu as MenuItem[];

function linkRel(href: string): string | undefined {
	return href.startsWith("http") ? "noopener noreferrer" : undefined;
}

function linkTarget(href: string): string | undefined {
	return href.startsWith("http") ? "_blank" : undefined;
}

function hasChildren(item: MenuItem): boolean {
	return Array.isArray(item.children) && item.children.length > 0;
}

function subId(index: number): string {
	return `ui-nav-drawer-sub-${index}`;
}
---

<div
	id="site-nav-drawer"
	class:list={["ui-nav-drawer-root", rootVisibility]}
	role="presentation"
>
	<div class="ui-nav-drawer-backdrop" data-navbar-close aria-hidden="true"></div>

	<aside
		class="ui-nav-drawer--sheet"
		role="dialog"
		aria-modal="true"
		aria-label={headerData.aria.drawer}
	>
		<!-- Warstwy "talia kart" - dekoracja, wjezdzaja przed trescia-->
		<div class="ui-nav-drawer__deck" aria-hidden="true">
			<div class="ui-nav-drawer__layer ui-nav-drawer__layer--1"></div>
			<div class="ui-nav-drawer__layer ui-nav-drawer__layer--2"></div>
			<div class="ui-nav-drawer__layer ui-nav-drawer__layer--3"></div>
		</div>

		<div class="ui-nav-drawer__content">
			<!-- Close button: Same layout as the hamburger in the navbar
        (3 stripes, 44x44, same setup), stripes morph in X
        after opening the drawer, so the icon "does not switch"-->
			<div class="ui-nav-drawer__top">
				<button
					type="button"
					data-navbar-close
					class="ui-nav-drawer__close"
					aria-label={headerData.aria.menuClose}
				>
					<span class="ui-nav-drawer__close-bar" aria-hidden="true"></span>
					<span class="ui-nav-drawer__close-bar" aria-hidden="true"></span>
					<span class="ui-nav-drawer__close-bar" aria-hidden="true"></span>
				</button>
			</div>

			<div class="ui-nav-drawer__scroller">
				<nav class="ui-nav-drawer__nav" aria-label={headerData.aria.navMain}>
					{menu.map((item, i) =>
						hasChildren(item) ? (
							<div class="ui-nav-drawer__item" style={`--stagger: ${i}`}>
								<div class="ui-nav-drawer__link-row">
									<a
										href={getNovaNavigationPath(item.href, locale)}
										class="ui-nav-drawer__link"
										data-navbar-close
									>
										<!-- Why span: navbar.js measures the width of the label,
               to position the chevron just behind the text-->
										<span class="ui-nav-drawer__label">{item.label}</span>
									</a>
									<button
										type="button"
										class="ui-nav-drawer__expand"
										data-navbar-sub-toggle
										aria-expanded="false"
										aria-controls={subId(i)}
										aria-label={headerData.aria.menuExpand + ": " + item.label}
									>
										<svg
											class="ui-nav-drawer__chevron"
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											aria-hidden="true"
										>
											<path
												d="M3 6L8 11L13 6"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</button>
								</div>
								<div class="ui-nav-drawer__sub" id={subId(i)}>
									<div class="ui-nav-drawer__sub-inner">
										<nav
											class="ui-nav-drawer__sub-nav"
											aria-label={item.label}
										>
											{item.children!.map((child) => (
												<a
													href={getNovaNavigationPath(child.href, locale)}
													class="ui-nav-drawer__sub-link"
													data-navbar-close
												>
													{child.label}
												</a>
											))}
										</nav>
									</div>
								</div>
							</div>
						) : (
							<div class="ui-nav-drawer__item" style={`--stagger: ${i}`}>
								<a
									href={getNovaNavigationPath(item.href, locale)}
									class="ui-nav-drawer__link"
									data-navbar-close
								>
									{item.label}
								</a>
							</div>
						)
					)}

					<!-- CTA as last menu item: same entry rhythm
          and appearance, no separate block at the bottom-->
					<div class="ui-nav-drawer__item" style={`--stagger: ${menu.length}`}>
						<a
							href={getNovaNavigationPath(headerData.cta.href, locale)}
							class="ui-nav-drawer__cta"
							data-navbar-close
						>
							{headerData.cta.label}
						</a>
					</div>
				</nav>

				<div class="ui-nav-drawer__bottom">
					<LanguageSwitch locale={locale} />
				</div>

				<div class="ui-nav-drawer__social-row">
					{socialLinks.map(({ href, icon, label }) => (
						<a
							href={href}
							class="ui-nav-drawer__social-link"
							aria-label={label}
							rel={linkRel(href)}
							target={linkTarget(href)}
						>
							<i class={icon} aria-hidden="true"></i>
						</a>
					))}
				</div>
			</div>
		</div>
	</aside>
</div>
