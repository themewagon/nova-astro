---
// Dlaczego: py-4 lg:py-7 daje odpowiednia wysokosc navbara (mobile ~76px przez MenuToggle 44px, desktop ~76px), komfortowy target klikania (min 44px) i czytelne proporcje.
// Dlaczego: MobileDrawer jest w Layout.astro (poza headerem), poniewaz backdrop-filter na headerze
//           tworzy containing block i position: fixed drawer bylby obcinany do headera zamiast viewportu.
import NavbarMainCentered from "@components/ui/molecules/Navbar/shared/NavbarMainCentered.astro";
import type { NavTheme } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { navThemeClasses } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";

interface Props {
	theme?: NavTheme;
}

const { theme = "transparent" } = Astro.props;
---

<header
	data-site-header
	transition:animate="none"
	class:list={[
		"fixed top-0 left-0 z-[1000] w-full py-4 lg:py-7",
		theme === "transparent" ? "nav-transparent" : "",
		navThemeClasses[theme],
	]}
>
	<NavbarMainCentered />
</header>
