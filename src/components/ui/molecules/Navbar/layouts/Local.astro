---
import companyRaw from "@data/global/company.json";
import type { CompanyConfig } from "@/types/config";
import NavbarMainCentered from "@components/ui/molecules/Navbar/shared/NavbarMainCentered.astro";
import type { NavTheme } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { navThemeClasses } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { getEnabledSocialLinks } from "@utils/socials";

interface Props {
	theme?: NavTheme;
}

const { theme = "transparent" } = Astro.props;

const company = companyRaw as CompanyConfig;
const telHref = `tel:${company.phone.replace(/[^\d+]/g, "")}`;

// Dlaczego: social media z company.json (jeden wpis = platforma + link +
// visibility switch). The helper only returns enabled and with a link.
const socialLinks = getEnabledSocialLinks(company);
---

<header
	data-site-header
	class="fixed top-0 left-0 z-[1000] flex w-full flex-col"
>
	<div
		class:list={[
			"ui-nav-utility-strip w-full border-b leading-none",
			theme === "transparent" ? "border-white/10 bg-black/40 text-white backdrop-blur-sm" : "",
			theme === "light" ? "border-brand-dark/10 bg-brand-dark text-white" : "",
			theme === "dark" ? "border-white/10 bg-black/35 text-white backdrop-blur-sm" : "",
		]}
	>
		<div class="ui-container flex flex-nowrap items-center justify-between gap-x-3 gap-y-1 py-1 text-[0.6875rem] font-medium sm:gap-x-5 lg:py-1.5 lg:text-xs">
			<div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-0.5 sm:flex-nowrap sm:gap-x-5">
				<a href={telHref} class="ui-nav-utility-link inline-flex max-w-full items-center gap-1 rounded-sm text-inherit hover:opacity-90">
					<i class="ph ph-phone shrink-0 text-sm opacity-90" aria-hidden="true"></i>
					<span class="truncate">{company.phone}</span>
				</a>
				<a href={`mailto:${company.email}`} class="ui-nav-utility-link inline-flex max-w-full items-center gap-1 rounded-sm text-inherit hover:opacity-90">
					<i class="ph ph-envelope-simple shrink-0 text-sm opacity-90" aria-hidden="true"></i>
					<span class="max-w-[10rem] truncate sm:max-w-[14rem] lg:max-w-[20rem]">{company.email}</span>
				</a>
			</div>
			<div class="flex shrink-0 items-center gap-1 sm:gap-1.5">
				{socialLinks.map((s) => (
					<a
						href={s.href}
						class="ui-nav-utility-link inline-flex size-8 items-center justify-center rounded-full border border-current/20 text-inherit transition-colors hover:border-current/35 hover:bg-white/10 sm:size-9"
						target="_blank"
						rel="noopener noreferrer"
						aria-label={s.label}
					>
						<i class:list={[s.icon, "text-[0.9375rem] sm:text-base"]} aria-hidden="true" />
					</a>
				))}
			</div>
		</div>
	</div>

	<div
		class:list={[
			"w-full py-4 lg:py-6",
			theme === "transparent" ? "nav-transparent" : "",
			navThemeClasses[theme],
		]}
	>
		<NavbarMainCentered />
	</div>
</header>
