---
// Why: "plain" is a classic, always visible navbar with a solid background.
// Unlike centered/floating, it is not a transparent overlay
// on hero, only a permanent bar with a background and a border. Thanks to this, the content of the page
// it never gets lost under navigation, and the variant is suitable for subpages without a hero.
// The header height is measured and compensated by initSiteHeaderHeight() (core.css),
// so the fixed navbar does not overlap the first section.
import NavbarMainCentered from "@components/ui/molecules/Navbar/shared/NavbarMainCentered.astro";
import type { NavTheme } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { navThemeClasses } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";

interface Props {
	theme?: NavTheme;
}

const { theme = "light" } = Astro.props;

// Why: plain always renders a solid background, so there is no "transparent".
// makes sense for this variant. We map it to a light bar for content
// remained legible on every page.
const resolvedTheme: NavTheme = theme === "transparent" ? "light" : theme;

// Why: py-4 lg:py-7 gives the appropriate height to the navbar (mobile ~76px,
// desktop ~76px), komfortowy target klikania (min 44px) i czytelne proporcje.
// Without this padding, the strip sticks to the logo and initSiteHeaderHeight()
// it measures too low a height, so the content overlaps under the fixed navbar.
---

<header
	data-site-header
	transition:animate="none"
	class:list={[
		"fixed top-0 left-0 z-[1000] w-full py-4 lg:py-7",
		navThemeClasses[resolvedTheme],
	]}
>
	<NavbarMainCentered />
</header>
