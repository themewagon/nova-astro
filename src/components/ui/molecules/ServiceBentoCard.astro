---
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import { formatInternalLink } from "@utils/url";

type ServiceItem = {
  icon: string;
  title: string;
  description: string;
  image?: string;
  alt?: string;
  size?: "large" | "medium" | "small";
  tone?: "cream";
};

interface Props {
  item: ServiceItem;
  moreLabel?: string;
  moreHref?: string;
}

const { item, moreLabel = "", moreHref = "" } = Astro.props as Props;

const cardClasses: Record<NonNullable<ServiceItem["size"]>, string> = {
  large: "lg:row-span-3 min-h-[25rem] lg:min-h-[38rem]",
  medium: "min-h-[21rem]",
  small: "",
};
---

<article
  class:list={[
    "group relative isolate min-w-0 overflow-hidden ui-radius-lg border ui-elevation-soft",
    item.size === "small"
      ? "border-white/50 bg-white/45 backdrop-blur-xl"
      : item.tone === "cream"
        ? "border-white/60 bg-brand-cream/50 backdrop-blur-xl"
        : "border-brand-dark/10 ui-bg-surface",
    cardClasses[item.size || "small"],
  ]}
>
  {item.image && (
    <div class="absolute inset-x-0 bottom-0 z-[-1] h-[55%] overflow-hidden">
      <SmartImage
        src={item.image}
        alt={item.alt || item.title}
        width={800}
        height={800}
        sizes="(max-width: 768px) 100vw, 420px"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class:list={[item.tone === "cream" ? "absolute inset-0 bg-gradient-to-b from-brand-cream/60 via-brand-cream/25 to-transparent" : "absolute inset-0 bg-gradient-to-b from-brand-light via-brand-light/40 to-transparent"]}></div>
    </div>
  )}

  <div class="flex min-h-0 flex-1 flex-col p-6 transition-transform duration-300 will-change-transform group-hover:-translate-y-1 sm:p-8">
    {item.size === "small" ? (
      <div class="relative z-10 flex items-start gap-4">
        <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary">
          <Icon name={item.icon} class="text-xl" />
        </div>
        <div class="min-w-0">
          <Heading level={3} variant="feature-heading-md" class="text-brand-dark">{item.title}</Heading>
          <Text variant="feature-body-sm" class="mt-2 text-brand-dark/65">{item.description}</Text>
        </div>
      </div>
    ) : (
      <div class="relative z-10 max-w-sm">
        <Heading level={3} variant="feature-heading-md" class="mt-5 max-w-xs text-brand-dark">{item.title}</Heading>
        <Text variant="feature-body-sm" class="mt-3 max-w-xs text-brand-dark/65">{item.description}</Text>
        {moreLabel && moreHref && (
          <a href={formatInternalLink(moreHref)} class="group/link mt-5 inline-flex items-center gap-2 text-xs font-semibold text-brand-primary transition-colors duration-300 hover:text-brand-accent">
            <span>{moreLabel}</span>
            <Icon name="arrow-right" class="transition-transform duration-300 group-hover/link:translate-x-1" />
          </a>
        )}
      </div>
    )}
  </div>
</article>
