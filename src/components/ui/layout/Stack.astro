---
type DirValue = "row" | "col" | Record<string, "row" | "col">;

interface Props {
  /** "row" | "col" lub { default:"col", md:"row" } */
  direction?: DirValue;
  /** "sm" | "md" | "lg" | "xl" lub dowolny string */
  gap?: string;
  wrap?: boolean;
  /** "start" | "center" | "end" | "stretch" */
  align?: "start" | "center" | "end" | "stretch";
  class?: string;
}

const {
  direction = "col",
  gap = "md",
  wrap = false,
  align,
  class: className,
} = Astro.props;

const gapMap: Record<string, string> = {
  sm: "gap-3", md: "gap-6", lg: "gap-8", xl: "gap-12",
};
const gapClass = gapMap[gap] || gap;

function dirToClasses(d: DirValue): string {
  if (typeof d === "string") return d === "row" ? "flex-row" : "flex-col";
  return Object.entries(d)
    .map(([bp, v]) => {
      const cls = v === "row" ? "flex-row" : "flex-col";
      if (bp === "default") return cls;
      return `${bp}:${cls}`;
    })
    .join(" ");
}

const wrapClass = wrap ? "flex-wrap" : "";
const alignMap: Record<string, string> = {
  start: "items-start", center: "items-center", end: "items-end", stretch: "items-stretch",
};
const alignClass = align ? alignMap[align] || align : "";
---

<div class:list={["flex", dirToClasses(direction), wrapClass, alignClass, gapClass, className]}>
  <slot />
</div>
