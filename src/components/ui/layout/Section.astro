---
import type { HTMLAttributes } from 'astro/types';

interface Props {
	id?: string;
	class?: string;
    style?: HTMLAttributes<'section'>['style'];
    /** Background tone: base, page (light gray), accent (brand) */
	tone?: 'base' | 'page' | 'accent';
}

const {
	id,
	class: className = '',
	style,
	tone,
} = Astro.props;

const toneClasses = {
    'base': 'ui-bg-base',
    'page': 'ui-bg-page',
    'accent': 'ui-bg-accent'
};

const appliedToneClass = tone ? toneClasses[tone] : '';
const SectionTag = 'section';
---

<SectionTag
	id={id}
	style={style}
	data-motion-section
	class:list={["ui-section", appliedToneClass, className]}
>
	<slot />
</SectionTag>
