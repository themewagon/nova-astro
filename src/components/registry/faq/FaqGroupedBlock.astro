---
import Section from "@components/ui/layout/Section.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import faqData from "@data/sections/faq.json";

// Dlaczego: FaqGroupedBlock to FAQ pogrupowany wg kategorii w jednym kontenerze.
// It differs from FaqGridBlock in that the categories are in a vertical list (not a grid).
// Perfect for pages with many questions where grouping makes navigation easier.
interface Props {
	class?: string;
	title?: string;
	description?: string;
	tagline?: string;
	/** Section header tag: 'h2' by default, 'h1' when the block is the first section of a page without hero (SEO).*/
	headingTag?: string;
}

const { 
	class: className = "", 
	title = faqData.title, 
	description = faqData.description,
	tagline = faqData.tagline,
	headingTag = "h2"
} = Astro.props;

const categories = faqData.categories || [];
---

<Section class:list={["ui-bg-page", className]}>
	<div class="ui-container max-w-4xl mx-auto">
		<SectionHeader 
			title={title}
			description={description}
			tagline={tagline}
			titleTag={headingTag}
			align="center"
		/>

		<!-- Dlaczego: jeden kontener z pogrupowanymi kategoriami.
   Each category has a heading and a list of questions from accordion.
   Easier navigation than a grid when there are many categories.-->
		<div class="mt-12 ui-bg-surface ui-radius-xl ui-elevation-soft border border-brand-dark/10 overflow-hidden">
			{categories.map((cat, index) => (
				<div class="divide-y divide-brand-dark/5" data-accordion>
					<div class="px-8 py-5 ui-bg-surface border-b border-brand-dark/5">
						<Heading level={3} variant="feature-title" class="ui-text-on-light">
							{cat.title}
						</Heading>
					</div>
					{cat.items.map((item) => (
						<details class="group cursor-pointer">
						<summary class="flex min-w-0 items-start justify-between w-full px-8 py-5 text-left list-none select-none">
								<Text variant="feature-body-sm" tag="span" class="font-bold pr-8 ui-text-on-light">
									{item.q}
								</Text>
								<div class="transition-transform duration-300 group-open:-rotate-45 text-brand-primary shrink-0 mt-0.5">
									<svg xmlns="http://www.w3.org/2000/svg" class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
									</svg>
								</div>
							</summary>
							<div class="px-8 pb-5">
								<Text variant="feature-body-sm" class="ui-text-on-light-subtle">
									{item.a}
								</Text>
							</div>
						</details>
					))}
				</div>
			))}
		</div>
	</div>
</Section>
