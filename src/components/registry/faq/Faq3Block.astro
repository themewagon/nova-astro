---
import Section from "@components/ui/layout/Section.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import data from "@data/sections/faq3.json";
import { ACTIVE_TEMPLATE } from "@config/template";

interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  sectionId?: string;
  title?: string;
  description?: string;
  tagline?: string;
  items?: FaqItem[];
  headingTag?: string;
  class?: string;
}

const {
  sectionId = "faq3",
  title,
  description,
  tagline,
  items,
  headingTag = "h2",
  class: className = "",
} = Astro.props as Props;

const fallback = ACTIVE_TEMPLATE === "nova" ? undefined : data;
const resolvedTitle = title || fallback?.title || "";
const resolvedDescription = description || fallback?.description || "";
const list = items && items.length > 0 ? items : fallback?.items ?? [];
---

<Section id={sectionId} tone="page" class:list={["ui-bg-page", className]}>
  <div class="ui-container">
    <SectionHeader
      title={resolvedTitle}
      description={resolvedDescription}
      titleVariant="section-heading-lg"
      titleTag={headingTag}
      align="center"
      class="mx-auto max-w-3xl"
    />

    <div class="mx-auto mt-12 w-full max-w-3xl space-y-3" data-accordion>
      {list.map((item, index) => (
        <details
          class="group ui-bg-surface ui-radius-lg overflow-hidden border border-brand-dark/10 transition-colors duration-300 open:border-brand-dark/20"
          open={index === 0 ? true : undefined}
        >
          <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-6 px-5 py-5 text-left md:px-7 md:py-6">
            <Heading tag="h3" class="!m-0 pr-4 !text-[17px] leading-snug font-medium text-brand-dark md:!text-[18px]">
              {item.q}
            </Heading>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-brand-dark/15 text-brand-primary transition-transform duration-300 group-open:rotate-45">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-6 md:px-7">
            <Text variant="feature-body-sm" class="max-w-2xl ui-text-on-light-subtle">
              {item.a}
            </Text>
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>
