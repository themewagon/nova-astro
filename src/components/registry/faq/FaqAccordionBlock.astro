---
import Section from "@components/ui/layout/Section.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import data from "@data/sections/faq-accordion.json";

// Dlaczego: FaqAccordionBlock to wierna kopia sekcji FAQ z projektu
// FaqSimpleBlock, "simple" variant used on the reference site:
// accordion with <details> where the first question is by default open, header
// section with the section-heading-lg variant (larger than standard) and label
// in the right side. Content input was taken over by the global motion mechanism.
interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  /** Section ID, default "faq".*/
  sectionId?: string;
  /** Content language with JSON. PL is the default language for this section copy.*/
  lang?: "pl" | "en";
  title?: string;
  description?: string;
  tagline?: string;
  items?: FaqItem[];
  /** Section header tag: 'h2' by default, 'h1' when the block is the first section of a page without hero (SEO).*/
  headingTag?: string;
  /** Additional classes per section (e.g. with PageBuilder).*/
  class?: string;
}

const {
  sectionId = "faq",
  lang = "pl",
  title,
  description,
  tagline,
  items,
  headingTag = "h2",
  class: className = "",
} = Astro.props as Props;

const t = data[lang] ?? data.pl;

// Why: "props || json" pattern to make the block work independently with the data
// sections, and PageBuilder or CMS could overwrite any text.
const resolvedTitle = title || t.title;
const resolvedDescription = description || t.description;
const resolvedTagline = tagline || t.tagline;
const list = items && items.length > 0 ? items : t.items;
---

<Section id={sectionId} tone="page" class:list={["ui-bg-page", className]}>
  <div class="ui-container">
    <!-- Why: section header with the section-heading-lg variant (as in the original
         client) and a max-in-3xl limitation so that the lead does not spread throughout
         width.-->
    <SectionHeader
            title={resolvedTitle}
            description={resolvedDescription}
            tagline={resolvedTagline}
            titleVariant="section-heading-lg"
            titleTag={headingTag}
            align="center"
            class="max-w-3xl"
    />

    <!-- Why: accordion <details> with first question open by default
         (open to idx 0). The "group-open:-rotate-45" style rotates the plus icon
         at the moment of opening. Layout and dimensions 1:1 from the customer's original.-->
    <div class="mx-auto mt-12 w-full max-w-2xl space-y-2" data-accordion>
      {list.map((item, idx) => (
        <details
          class="group ui-bg-surface ui-radius-lg overflow-hidden border border-brand-dark/5"
          open={idx === 0 ? true : undefined}
        >
          <summary class="flex w-full cursor-pointer list-none select-none items-center justify-between p-4 text-left">
            <Heading tag="h3" class="pr-8 !text-[16px] leading-snug font-medium text-brand-dark/80">
              {item.q}
            </Heading>
            <div class="text-brand-primary transition-transform duration-300 group-open:-rotate-45">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </summary>
          <div class="faq-answer px-4 pb-4">
            <Text variant="feature-body-sm" class="ui-text-on-light-subtle">
              {item.a}
            </Text>
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>
