---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import SectionHeader from "@components/ui/molecules/SectionHeader.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import data from "@data/sections/services-zigzag.json";
import { formatInternalLink } from "@utils/url";

// Why: The service element type maps to a JSON structure
// (src/data/sections/services-zigzag.json).href and linkLabel are optional because the
// component has safe fallbacks when the client does not provide a link in the CMS.
type ServiceItem = {
  image: string;
  icon: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
};

export interface Props {
  sectionId?: string;
/** Content language with JSON. EN is the default language, EN holds the equivalent. */
  lang?: "pl" | "en";
  title?: string;
  description?: string;
  items?: ServiceItem[];
  /** Section heading tag: 'h2' by default, 'h1' when the block is the first section without hero (SEO). */
  headingTag?: string;
/** Additional section classes, for example from PageBuilder. */
  class?: string;
}

const {
sectionId = "services-zigzag",
lang = "pl",
title,
description,
items,
headingTag = "h2",
class: className = "",
} = Astro.props as Props;

// Why: lyrics are in SSOT (Single Source of Truth) with fallback to JSON.Props from CMS or
// PageBuilder overwrite content from the feed.
const t = data[lang] ?? data.pl;
const resolvedTitle = title || t.title;
const resolvedDescription = description || t.description;
const resolvedItems = items ?? t.items ?? [];
// Why: Anchor to contact is a safe default target when the block is embedded without data or
// the item does not have a set link.
const DEFAULT_HREF = "/kontakt/";
const DEFAULT_LINK_LABEL_PL = "Umów konsultację";
const DEFAULT_LINK_LABEL_EN = "Book a consultation";
const defaultLinkLabel = lang === "en" ? DEFAULT_LINK_LABEL_EN : DEFAULT_LINK_LABEL_PL;
---

<!-- Why: The zigzag layout renders services in a two-column grid on md+
(1 column on mobile), and even elements reverse the column order,
so that photos and texts are arranged alternately.The header section is
centered (align="center"), according to the structure of the original. -->
<Section id={sectionId} class:list={[className]}>
  <Container>
    <SectionHeader title={resolvedTitle} description={resolvedDescription} titleTag={headingTag} align="center" />

    <div class="space-y-16 md:space-y-20">
      {resolvedItems.map((item, i) => {
        // Why: odd elements (index 1, 3, ...) get an order-2
        // on the first child (photo), so the image lands on md+ after
        // prawej stronie i powstaje efekt zygzaka.
        const isReversed = i % 2 === 1;
        return (
          <div
            class:list={[
              "grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center",
              isReversed && "md:[&>:first-child]:order-2",
            ]}
          >
            <!-- Why: a photo in a fixed 4:3 aspect ratio prevents jumps
layout (CLS), and rounded-2xl + shadow holds the card style. -->
            <div class="aspect-[4/3] overflow-hidden rounded-2xl shadow-md">
              <SmartImage
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover"
                width={800}
                height={600}
              />
            </div>

            <div class="flex flex-col gap-4">
              <!-- Why: an icon in a square with a delicate branding background,
according to the starter-kit token system (border and bg
from opacity to --color-brand-primary). -->
              <div class="inline-flex size-12 items-center justify-center rounded-xl border border-brand-primary/15 bg-brand-primary/10 text-brand-primary">
                <Icon name={item.icon} size={24} />
              </div>

              <Heading level={3} variant="feature-title" class="text-brand-dark text-2xl font-bold font-heading">
                {item.title}
              </Heading>

              <Text variant="feature-body-sm" class="text-brand-dark/70 leading-relaxed text-base">
                {item.description}
              </Text>

              <!-- Why: formatInternalLink guarantees trailing slash for
internal links (requirement of SEO starter kit) and passes
anchors and external links unchanged. -->
              <a
                href={formatInternalLink(item.href || DEFAULT_HREF)}
                class="inline-flex items-center gap-2 mt-2 font-semibold text-brand-primary transition-colors hover:underline underline-offset-4"
              >
                {item.linkLabel || defaultLinkLabel}
                <span aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</Section>
