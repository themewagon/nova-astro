---
// Why: QUERY LENGTH LIMIT EXCEEDED. MAX ALLOWED QUERY : 500 CHARS
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/steps-numbered.json";

type Step = {
  num: string;
  title: string;
  description: string;
};

export interface Props {
  /* * Content language from JSON. PL is the default language, EN is the English equivalent. */
  locale?: "pl" | "en";
  /* * Full section content ({ en, en }). Props override JSON. */
  data?: typeof jsonData;
  /* * Section header tag: 'h2' by default, 'h1' when the block is the first section of the page without hero (SEO). */
  headingTag?: string;
}

const props = Astro.props as Props;
const locale = props.locale ?? "pl";
const headingTag = props.headingTag ?? "h2";
// Why: the pattern "props.data || jsonData[locale]" (as in AboutExpertBlock), so that the block
// works independently with the section data, and PageBuilder or CMS can overwrite the content.
// When the date comes from the outside, we choose the language variant (pl/en) in it, as JSON
// does.
const t = (props.data ? props.data[locale] : jsonData[locale]) || jsonData.pl;
const steps = (t.steps ?? []) as Step[];
---

<Section tone="base" class:list={["border-t border-brand-dark/10"]}>
  <Container>
    <div class="mx-auto max-w-4xl text-center">
      {/* Why: Why: accent-label from ui-type-accent-label token, but color taken
          from the global text-brand-primary, because this is what the eyebrow looked like at the customer's. */}
      <Text variant="accent-label" tag="p" class="!text-brand-primary">{t.eyebrow}</Text>
      {/* Why: Why: h2 header in variant section-heading-lg (clamp), two lines
          separated <br /> from the headingLines array with JSON (as at the client). */}
      <Heading tag={headingTag} variant="section-heading-lg" class="mt-4 !font-extrabold !leading-[1.1]">
        {t.headingLines.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </Heading>
    </div>

    {/* Why: Why: grid mobile-first: 1 column per mobile (gap-10), 3 columns
        on the desktop (md:grid-cols-3 md:gap-6), just like at the client. */}
    <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-6">
      {steps.map((step, i) => (
        <article class="relative text-center">
          {/* Why: Why: dashed arrow links steps 1 and 2, never last
              (i < steps.length - 1). Only visible on desktop (md:flex).
              border-brand-primary/40 is a brand token instead of a client
              var(--color-brand-primary). */}
          {i < steps.length - 1 && (
            <div class="pointer-events-none absolute right-0 top-8 z-10 hidden w-8 -translate-y-1/2 items-center md:flex">
              <span class="h-0 w-full border-t-2 border-dashed border-brand-primary/40"></span>
              <svg
                class="absolute -right-1 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </div>
          )}
          {/* Why: Why: square with step number (h-14 w-14, rounded-sm) instead of
              sVG icons, as at the client. The number comes directly from JSON. */}
          <span class="mx-auto mb-6 inline-flex h-14 w-14 items-center justify-center rounded-sm bg-brand-primary text-xl font-extrabold text-white">{step.num}</span>
          <Heading level={3} class="!text-lg !font-extrabold">{step.title}</Heading>
          <Text variant="body" class="mt-3 !font-semibold !leading-7">{step.description}</Text>
        </article>
      ))}
    </div>

    {/* Why: Why: decorative gradient line under the grid, hidden on mobile
        (hidden md:flex). via-brand-dark/10 replaces the client via-outline/70. */}
    <div class="relative mt-10 hidden items-center justify-center md:flex" aria-hidden="true">
      <div class="h-px w-full max-w-[720px] bg-gradient-to-r from-transparent via-brand-dark/10 to-transparent"></div>
    </div>
  </Container>
</Section>
