---
// Why: MarqueeImageWallBlock is a photo wall composed of 3 independent rows (pattern
// transferred from a reference layout and generalized. Each row has its own proportions and
// card widths, making the section look like a gallery of successes.
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";

type WallImage = {
  src?: string;
  thumb?: string;
  alt?: string;
};

interface Props {
  sectionId?: string;
  title?: string;
  description?: string;
  images?: WallImage[];
/** Label above the section title, editable through JSON. */
  wallLabel?: string;
/** Empty state text shown when no images are available. */
  wallEmptyState?: string;
  /** Section heading tag: 'h2' na homepage (hero ma h1), 'h1' na podstronach (SEO). */
  headingTag?: string;
}

const {
  sectionId = "galeria",
  title = "",
  description = "",
  images: rawImages = [],
  wallLabel = "Nasze realizacje",
  wallEmptyState = "Brak zdjęć do wyświetlenia.",
  headingTag = "h2",
} = Astro.props;
const images = Array.isArray(rawImages) ? rawImages.filter((image) => image?.src) : [];

type WallRow = { aspect: string; width: string };
type WallLayout = { visibility: string; rows: WallRow[] };

// Why: two responsive configurations - mobile and desktop get 3 rows. The photos are divided
// into 3 groups (several pieces each), so each photo appears only in ONE row and is not
// repeated 3 times on the screen at once (like with a full list in each row). Each row has
// its own card proportions. Different dimensions break the monotony of the grid and give
// depth.
const layouts: WallLayout[] = [
  {
    // Widoczne tylko na mobile (< md), ukryte na desktopie
    visibility: "md:hidden",
    rows: [
      { aspect: "aspect-[3/4]", width: "w-[150px]" },
      { aspect: "aspect-[4/5]", width: "w-[170px]" },
      { aspect: "aspect-[3/4]", width: "w-[140px]" },
    ],
  },
  {
    // Visible from md up (desktop/tablet): same 3 groups, larger tabs
    visibility: "hidden md:block",
    rows: [
      { aspect: "aspect-[3/4]", width: "w-[200px] md:w-[260px]" },
      { aspect: "aspect-[4/5]", width: "w-[220px] md:w-[300px]" },
      { aspect: "aspect-[3/4]", width: "w-[180px] md:w-[240px]" },
    ],
  },
];

// Why: photos are divided sequentially into groups (as many groups as rows) so that the
// numbers go sequentially and each photo appears only in ONE row of a given layout. Global
// numbering (#1..#N) is common because we map the original photo indexes.
const globalNumber = new Map<WallImage, number>();
images.forEach((image, index) => globalNumber.set(image, index + 1));

const layoutsWithGroups = layouts.map((layout) => {
  const splitAt = Math.ceil(images.length / layout.rows.length);
  const groups: WallImage[][] = [];
  for (let i = 0; i < layout.rows.length; i++) {
    groups.push(images.slice(i * splitAt, (i + 1) * splitAt));
  }
  return { ...layout, groups };
});

// Why: preloading the first few thumbnails shortens the time until the wall first renders
// before the rest is lazily loaded by SmartImage.
const firstThumbsPreload = images.slice(0, 6).map((image) => image.thumb || image.src || "").filter(Boolean);
---

<Section id={sectionId} tone="page">
  {firstThumbsPreload.map((href) => <link rel="preload" as="image" href={href} />)}

  <Container>
    <div class="space-y-4">
      <span class="ui-type-accent-label block">{wallLabel}</span>
      <Heading tag={headingTag} variant="section-title">{title}</Heading>
      <Text variant="body">{description}</Text>
    </div>
  </Container>

  {images.length > 0 ? (
    <div class="relative isolate mt-10 space-y-4 md:space-y-5">
      {layoutsWithGroups.map((layout) => (
        <div class={layout.visibility}>
          {layout.rows.map((row, rowIndex) => {
            const group = layout.groups[rowIndex] ?? [];
            return (
              <div class="relative z-10 overflow-hidden py-1">
                {/* Masks on the sides blur the entry and exit of cards */}
                <div
                  style="mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);"
                >
                  <div class="flex gap-3 md:gap-4">
                    {group.map((image, index) => (
                      <div
                        class={`group relative ${row.width} shrink-0 cursor-zoom-in overflow-hidden border border-outline-variant bg-surface-dim transition-colors duration-300 hover:border-primary ${row.aspect}`}
                        data-lightbox
                        data-href={image.src}
                        data-title={image.alt || ""}
                      >
                        <SmartImage
                          src={image.src}
                          alt={image.alt || ""}
                          width={600}
                          height={800}
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        />

{/* Dark gradient downstairs to make the number legible */}
                        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent"></div>

{/* Photo number (global within the whole wall) */}
                        <span class="absolute bottom-3 left-3 font-heading text-sm font-bold uppercase tracking-[0.2em] text-white">
                          #{globalNumber.get(image) ?? ((index % group.length) + 1)}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  ) : (
    <Container>
      <div class="mt-10 rounded-md border border-outline-variant bg-surface-dim py-20 text-center">
        <Text variant="body">{wallEmptyState}</Text>
      </div>
    </Container>
  )}
</Section>
