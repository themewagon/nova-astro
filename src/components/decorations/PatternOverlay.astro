---
interface Props {
  variant?: 'dots' | 'mesh' | 'grid' | 'crosshatch' | 'noise';
  opacity?: string;
  color?: string;
  class?: string;
}

const {
  variant = 'dots',
  opacity = '0.12',
  color = 'var(--color-brand-primary)',
  class: className,
} = Astro.props;

interface SvgConfig {
  svg: string;
  size: string;
}

const patterns: Record<string, SvgConfig> = {
  dots: {
    svg: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"><circle cx="4" cy="4" r="1.5" fill="white"/></svg>',
    size: '1.5rem 1.5rem',
  },
  mesh: {
    svg: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"><path d="M0 20 L40 20 M20 0 L20 40" stroke="white" stroke-width="0.5"/></svg>',
    size: '2.5rem 2.5rem',
  },
  grid: {
    svg: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"><path fill="white" d="M0 0h1v1H0zm12 12h1v1h-1z"/></svg>',
    size: '1.5rem 1.5rem',
  },
  crosshatch: {
    svg: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"><path d="M0 0 L20 20 M20 0 L0 20" stroke="white" stroke-width="0.5"/></svg>',
    size: '1.25rem 1.25rem',
  },
  noise: {
    svg: '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>',
    size: '12.5rem 12.5rem',
  },
};

const pattern = patterns[variant] || patterns.dots;

const encodedSvg = pattern.svg
  .replace(/</g, '%3C')
  .replace(/>/g, '%3E')
  .replace(/"/g, "'")
  .replace(/\n/g, '');
---

<div
  class:list={['pointer-events-none absolute inset-0 z-0 select-none', className]}
  style={{
    WebkitMaskImage: `url("data:image/svg+xml,${encodedSvg}")`,
    maskImage: `url("data:image/svg+xml,${encodedSvg}")`,
    WebkitMaskSize: pattern.size,
    maskSize: pattern.size,
    WebkitMaskRepeat: 'repeat',
    maskRepeat: 'repeat',
    backgroundColor: color,
    opacity: opacity,
  }}
  aria-hidden="true"
/>
