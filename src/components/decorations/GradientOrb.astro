---
interface Props {
  color?: string;
  size?: string;
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center' | 'top' | 'bottom' | 'left' | 'right';
  blur?: string;
  opacity?: string;
  class?: string;
}

const {
  color = 'var(--color-brand-primary)',
  size = '50vw',
  position = 'top-left',
  blur = '120px',
  opacity = '0.35',
  class: className,
} = Astro.props;

const positionStyles: Record<string, string> = {
  'top-left': 'top-0 left-0 -translate-x-1/3 -translate-y-1/3',
  'top-right': 'top-0 right-0 translate-x-1/3 -translate-y-1/3',
  'bottom-left': 'bottom-0 left-0 -translate-x-1/3 translate-y-1/3',
  'bottom-right': 'bottom-0 right-0 translate-x-1/3 translate-y-1/3',
  center: 'top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2',
  top: 'top-0 left-1/2 -translate-x-1/2 -translate-y-1/3',
  bottom: 'bottom-0 left-1/2 -translate-x-1/2 translate-y-1/3',
  left: 'top-1/2 left-0 -translate-x-1/3 -translate-y-1/2',
  right: 'top-1/2 right-0 translate-x-1/3 -translate-y-1/2',
};
---

<div
  class:list={[
    'pointer-events-none absolute select-none',
    positionStyles[position] || positionStyles['top-left'],
    className,
  ]}
  style={{
    width: size,
    height: size,
    opacity: opacity,
    background: `radial-gradient(ellipse at center, ${color} 0%, transparent 70%)`,
    filter: `blur(${blur})`,
  }}
  aria-hidden="true"
/>
