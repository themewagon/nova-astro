---
interface Props {
  class?: string;
  overflow?: 'hidden' | 'visible';
  zIndex?: 'behind' | 'front';
}

const {
  class: className,
  overflow = 'hidden',
  zIndex = 'behind',
} = Astro.props;
---

<div
  class:list={[
    'pointer-events-none absolute inset-0 select-none',
    overflow === 'hidden' ? 'overflow-hidden' : 'overflow-visible',
    zIndex === 'behind' ? 'z-0' : 'z-10',
    className,
  ]}
  aria-hidden="true"
  data-decoration-layer
>
  <slot />
</div>
