---
import { getLegalLayout } from "@/config/template-layouts";

const LegalLayout = await getLegalLayout();
import company from "@data/global/company.json";
import privacyContent from "@/content/legal/privacy-policy-pl.json";
import { legalBodyToHtml } from "@utils/legal-body-to-html";

const injectData = (text: string) => text
  .replace(/{{COMPANY_NAME}}/g, company.name)
  .replace(/{{COMPANY_FULL_NAME}}/g, company.fullName)
  .replace(/{{COMPANY_ADDRESS}}/g, company.address)
  .replace(/{{COMPANY_CITY}}/g, company.city)
  .replace(/{{COMPANY_ZIP}}/g, company.zipCode)
  .replace(/{{COMPANY_NIP}}/g, company.nip)
  .replace(/{{COMPANY_REGON}}/g, company.regon || "")
  .replace(/{{COMPANY_KRS}}/g, company.krs)
  .replace(/{{COMPANY_EMAIL}}/g, company.email)
  .replace(/{{SITE_URL}}/g, company.siteUrl || "nasza-strona.pl");

const html = legalBodyToHtml(injectData(privacyContent.body));
const title = privacyContent.title;
const description = injectData(privacyContent.description || "");
---

<LegalLayout title={title} description={description} lastUpdated={privacyContent.lastUpdated} locale="pl">
  <div set:html={html} />
</LegalLayout>
