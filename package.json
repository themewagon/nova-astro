{
  "name": "templar-t001-nova",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node src/scripts/sync-phosphor-css.mjs",
    "dev": "astro dev",
    "postinstall": "patch-package && node src/scripts/sync-phosphor-css.mjs",
    "prebuild": "node src/scripts/sync-phosphor-css.mjs",
    "build": "npm run assets:gen && npm run assets:fonts && npm run assets:img && node src/scripts/scope-pages.mjs build && node src/scripts/clean-dist.mjs && node src/scripts/prune-images.mjs && node src/scripts/strip-html-comments.mjs && node src/scripts/prune-phosphor-css.mjs && node scripts/prefix-base-assets.mjs",
    "scope:restore": "node src/scripts/scope-pages.mjs restore",
    "preview": "astro preview",
    "astro": "astro",
    "check:hardcoded": "tsx src/scripts/check-hardcoded.ts",
    "check:types": "astro check --minimumSeverity error",
    "check:motion": "tsx src/scripts/check-legacy-motion.ts",
    "check:icons": "node src/scripts/prune-phosphor-css.mjs --check",
    "check:atomic": "tsx src/scripts/check-atomic-design.ts",
    "check:atomic:full": "tsx src/scripts/check-atomic-design.ts --scan-dirs src/components",
    "check:imports": "tsx src/scripts/check-import-paths.ts",
    "check:registrations": "tsx src/scripts/check-registrations.ts",
    "design:sync": "tsx src/scripts/sync-design.ts",
    "design:lint": "design.md lint design/*.md",
    "design:spec": "design.md spec design/nova.md --output public/design-spec",
    "assets:gen": "node src/scripts/generate-favicons.cjs",
    "assets:img": "tsx src/scripts/optimize-images.ts",
    "assets:thumbs": "tsx src/scripts/generate-gallery-thumbs.ts",
    "assets:fonts": "tsx src/scripts/download-fonts.ts",
    "assets:videos": "node src/scripts/compress-videos.mjs",
    "test": "vitest",
    "test:form": "node scripts/test-send-form.mjs",
    "check:form": "tsx src/scripts/check-form-config.ts",
    "check:form:client": "tsx src/scripts/check-form-config.ts --client",
    "test:mobile": "vitest run src/utils/mobile-layout-audit.test.ts",
    "check:mobile": "tsx src/scripts/check-mobile-layout.ts",
    "check:baseline-update": "tsx src/scripts/generate-baseline.ts",
    "check:content": "tsx src/scripts/check-content.ts",
    "check:seo": "tsx src/scripts/check-seo.ts",
    "check:seo:client": "tsx src/scripts/check-seo.ts --client",
    "check:cannibalization": "tsx src/scripts/check-cannibalization.ts",
    "check:polish": "tsx src/scripts/check-polish.ts",
    "check:links": "tsx src/scripts/check-links.ts",
    "check:page-registry": "tsx src/scripts/check-page-registry.ts",
    "check:data": "tsx src/scripts/check-data-contracts.ts",
    "ai:check": "npm run check:types && npm run check:data && npm run check:imports && npm run check:registrations && npm run check:motion && npm run test -- --run",
    "check:images": "tsx src/scripts/check-images.ts",
    "build:prod": "npm run build",
    "build:preview": "node scripts/build-preview.mjs",
    "package:marketplace": "node scripts/package-marketplace.mjs",
    "qa": "tsx src/scripts/run-qa.ts qa",
    "qa:strict": "tsx src/scripts/run-qa.ts strict",
    "qa:client": "tsx src/scripts/run-qa.ts client",
    "qa:help": "tsx src/scripts/run-qa.ts help",
    "audit:site": "tsx src/scripts/audit/index.ts",
    "audit:lighthouse": "node src/scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-glob": "^3.3.3",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.25",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/design.md": "^0.1.1",
    "@types/js-yaml": "^4.0.9",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
